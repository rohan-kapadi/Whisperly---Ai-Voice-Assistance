# Real-Time Voice Assistant Environment Configuration
# Copy this file to .env and fill in your keys.

# Speech-to-Text (STT) Provider
DEEPGRAM_API_KEY=

# Text-to-Speech (TTS) Provider
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# LLM Providers (Provide at least one: GEMINI, ANTHROPIC, or OPENAI)
# Gemini has a free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Weather API (Optional - defaults to Open-Meteo free API if empty)
WEATHER_API_KEY=

# Server Configuration
PORT=8080
HOST=localhost
